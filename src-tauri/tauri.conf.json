{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Panoramer",
  "version": "2.0.0",
  "identifier": "com.redzikowski.panoramer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Panoramer",
        "width": 1560,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "theme": "Dark",
        "dragDropEnabled": true,
        "backgroundColor": "#14161c"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "redzikowski.com",
    "copyright": "© redzikowski.com",
    "homepage": "https://redzikowski.com",
    "category": "Photography",
    "shortDescription": "Professional panorama stitcher",
    "longDescription": "Panoramer stitches photos (JPEG, TIFF, RAW) into spherical 360°, cylindrical, rectilinear and other panoramas. Idea and development: redzikowski.com",
    "licenseFile": "../LICENSE",
    "icon": ["../assets/icon.png", "../assets/icon.ico"],
    "windows": {
      "nsis": {
        "languages": ["Polish", "English"],
        "displayLanguageSelector": true,
        "installerIcon": "../assets/icon.ico",
        "installMode": "both"
      }
    }
  }
}
