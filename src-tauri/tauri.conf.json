{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Panoramer",
  "version": "2.1.0",
  "identifier": "com.redzikowski.panoramer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Panoramer",
        "width": 1560,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "theme": "Dark",
        "dragDropEnabled": true,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "redzikowski.com",
    "copyright": "© redzikowski.com",
    "homepage": "https://redzikowski.com",
    "category": "Photography",
    "shortDescription": "Professional panorama stitcher",
    "longDescription": "Panoramer stitches photos (JPEG, TIFF, RAW) into spherical 360°, cylindrical, rectilinear and other panoramas. Idea and development: redzikowski.com",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "Polish",
          "English"
        ],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "installMode": "both"
      }
    },
    "android": {
      "minSdkVersion": 26
    },
    "iOS": {
      "minimumSystemVersion": "15.0"
    }
  }
}